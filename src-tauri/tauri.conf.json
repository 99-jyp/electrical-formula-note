{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "전기 공식 노트",
  "version": "0.1.0",
  "identifier": "com.example.electricalformulanote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "전기 공식 노트",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:formula_note.db"
      ]
    }
  }
}
